{:deps {:aliases [:dev]}
 :dev-http {8080 ["resources/public" "classpath:public"]}
 :builds
 {:app
  {:target :browser
   :devtools {:preloads [devtools.preload]}
   :modules {:main {:init-fn yatg.dev/main}}
   :build-hooks [[build.manifest/generate-asset-list]]
   :dev {:output-dir "resources/public/app-js"}}

  :portfolio
  {:target :browser
   :modules {:main {:init-fn yatg.scenes/main}}
   :build-hooks [[build.manifest/generate-asset-list]]
   :dev {:output-dir "resources/public/portfolio-js"}}

  :test
  {:target :node-test
   :output-to "resources/test/tests.js"
   :ns-regexp "-test$"
   :autorun true}}}
